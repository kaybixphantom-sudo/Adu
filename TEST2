                local function gs(n)
                    local s = stats:FindFirstChild(n)
                    return s and s.Value or "N/A"
                end
                local str = tostring(gs("Strength"))
                local reb = tostring(gs("Rebirths"))
                local dur = tostring(gs("Durability"))
                local agi = tostring(gs("Agility"))
                strLbl.Text = "Strength: " .. str
