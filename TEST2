            local e = tick() - ST0
            local d = math.floor(e / 86400)
            local h = math.floor((e % 86400) / 3600)
            local m = math.floor((e % 3600) / 60)
            local s = math.floor(e % 60)
            TimeLbl.Text = string.format("%dd %dh %dm %ds", d, h, m, s)
        end
    end)

