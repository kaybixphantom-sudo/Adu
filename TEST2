local function DeepFind(p, name)
    local f = p:FindFirstChild(name)
    if f then return f end
    for _, v in pairs(p:GetDescendants()) do
        if v.Name == name then return v end
    end
    return nil
end

local function GetMuscleEvent()
    local list = {
        LP:FindFirstChild("MuscleEvent"),
        LP.Character and LP.Character:FindFirstChild("MuscleEvent"),
        RPS:FindFirstChild("MuscleEvent"),
        RPS:FindFirstChild("muscleEvent"),
        DeepFind(RPS, "MuscleEvent"),
        DeepFind(RPS, "muscleEvent")
    }
    for _, c in ipairs(list) do
        if c and (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) then return c end
    end
    return nil
end

local function GetRebirthRemote()
    local list = {
        RPS:FindFirstChild("rebirthRemote"),
        RPS:FindFirstChild("rEvents") and RPS.rEvents:FindFirstChild("rebirthRemote"),
        DeepFind(RPS, "rebirthRemote"),
        DeepFind(RPS, "RebirthRemote")
    }
    for _, c in ipairs(list) do
        if c and (c:IsA("RemoteEvent") or c:IsA("RemoteFunction")) then return c end
    end
    return nil
end

local function GetHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function Equip(names)
    local c = LP.Character
    if not c then return end
    for _, n in ipairs(names) do
        if c:FindFirstChild(n) then return end
    end
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, n in ipairs(names) do
            local t = bp:FindFirstChild(n)
            if t and t:IsA("Tool") then
                pcall(function() t.Parent = c end)
                return
            end
        end
    end
end

local function Fire(action)
    local m = GetMuscleEvent()
    if not m then return end
    local patterns = {
        {"punch", "leftHand"},
        {"punch", "rightHand"},
        {action},
        {action, "leftHand"},
        {action, "rightHand"},
    }
    for _, a in ipairs(patterns) do
        pcall(function()
            if m:IsA("RemoteFunction") then
                m:InvokeServer(unpack(a))
            else
                m:FireServer(unpack(a))
            end
        end)
    end
end

local function Notify(text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", {
            Title = "KhoiFarm",
            Text = text,
            Duration = 3
        })
    end)
end

local function DumpRemotes()
    print("=========== REMOTE LIST ===========")
    local count = 0
    for _, v in pairs(RPS:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
            count = count + 1
            print("[" .. v.ClassName .. "] " .. v:GetFullName())
        end
    end
    print("Total: " .. count)
    Notify("Đã in " .. count .. " remote vào F9!")
end

local function DumpTools()
    print("=========== TOOL LIST ===========")
    local bp = LP:FindFirstChild("Backpack")
    if bp then
        for _, v in pairs(bp:GetChildren()) do
            if v:IsA("Tool") then print("[Bag] " .. v.Name) end
        end
    end
    local char = LP.Character
    if char then
        for _, v in pairs(char:GetChildren()) do
            if v:IsA("Tool") then print("[Equipped] " .. v.Name) end
        end
    end
    Notify("Đã in Tool vào F9!")
end

