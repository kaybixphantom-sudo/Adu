            if S.ComboDura then ex = "rock" end
            if S.ComboAgi then ex = "pushup" end
            if S.Punch then ex = "punch" end

            if ex then
                Equip({"Punch", "punch", "Fist"})
                Fire(ex)
            end

            if S.KillList or S.KillAura then
                local h = GetHRP()
                if h then
                    for _, p in pairs(PL:GetPlayers()) do
                        if p ~= LP and p.Character then
                            local th = p.Character:FindFirstChild("HumanoidRootPart")
                            local hm = p.Character:FindFirstChildOfClass("Humanoid")
                            if th and hm and hm.Health > 0 then
                                local d = (h.Position - th.Position).Magnitude
                                if (S.KillList and d < 20) or (S.KillAura and d < S.Range) then
                                    Equip({"Punch", "punch", "Fist"})
                                    Fire("punch")
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

