        local nc = Instance.new("UICorner")
        nc.CornerRadius = UDim.new(0, 8)
        nc.Parent = notif
        local ns = Instance.new("UIStroke")
        ns.Color = Color3.fromRGB(255, 0, 0)
        ns.Thickness = 2
        ns.Parent = notif
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -20, 1, 0)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = text
        lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 13
        lbl.TextWrapped = true
        lbl.Parent = notif
        task.spawn(function()
            task.wait(duration or 3)
            TweenService:Create(notif, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
            TweenService:Create(lbl, TweenInfo.new(0.3), {TextTransparency = 1}):Play()
            task.wait(0.3)
            notif:Destroy()
        end)
    end

    return WindowObj
end

local function CreateMainUI()
    local Window = Library:NewWindow("KhoiFarm | Main")

    -- ======================= TAB MAIN =======================
    local MainTab = Window:NewTab("Main")
    local MainSec = MainTab:NewSection("User Settings")

    MainSec:NewSlider("Size", "Kích thước nhân vật", 500, 1, function(v)
        local hum = GetHum()
        if hum then
            pcall(function()
                hum.BodyDepthScale.Value = v / 10
                hum.BodyWidthScale.Value = v / 10
                hum.BodyHeightScale.Value = v / 10
                hum.HeadScale.Value = v / 10
            end)
        end
    end)

    MainSec:NewSlider("Speed", "Tốc độ chạy", 500, 16, function(v)
        local hum = GetHum()
        if hum then hum.WalkSpeed = v end
    end)

    MainSec:NewSlider("FOV", "Tầm nhìn Camera", 120, 70, function(v)
        workspace.CurrentCamera.FieldOfView = v
    end)

    local ProtSec = MainTab:NewSection("Protection and Visuals")
    local antiFlingConn
    ProtSec:NewToggle("Anti Fling", "Chống bị hất văng", function(s)
        if s then
            antiFlingConn = RunService.Heartbeat:Connect(function()
                local hrp = GetHRP()
                if hrp then
