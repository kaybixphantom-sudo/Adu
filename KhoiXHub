    function WindowObj:Notify(text, duration)
        local notif = Instance.new("Frame")
        notif.Size = UDim2.new(0, 260, 0, 50)
        notif.Position = UDim2.new(1, -280, 1, -70)
        notif.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
