local CorrectKey = "TeamTNdz"
local isVerifying = false

local function LoadMainScript()
    local SG = game:GetService("StarterGui")
    local function notify(t, m, d)
        pcall(function()
            SG:SetCore("SendNotification", {Title = t, Text = m, Duration = d or 3})
        end)
    end

    notify("TeamTN",                "Đang tải Muscle Legends Script...", 3)
    
    local ok, err = pcall(function()
      loadstring(game:HttpGet("https://raw.githubusercontent.com/ghjkl1312/GenX/refs/heads/main/genxloader.luau", true))()
    end)
    
    if ok then
        notify("TeamTN", "Kích hoạt thành công!", 3)
    else
        notify("TeamTN", "Lỗi nạp script: " .. tostring(err):sub(1, 40), 5)
    end
end

local function VerifyKey()
    if isVerifying then return end
    isVerifying = true
    
    if KeyInput.Text == CorrectKey then
        SubmitBtn.Text = "ĐÚNG KEY!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        task.wait(0.5)
        KeySystemUI:Destroy()
        LoadMainScript()
    else
        SubmitBtn.Text = "SAI KEY!"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(220, 0, 0)
        task.wait(1.2)
        SubmitBtn.Text = "KÍCH HOẠT"
        SubmitBtn.BackgroundColor3 = Color3.fromRGB(180, 20, 20)
        isVerifying = false
    end
end

SubmitBtn.MouseButton1Click:Connect(VerifyKey)
KeyInput.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        VerifyKey()
    end
end)
