local function GetMuscleEvent()
    local d = LP:FindFirstChild("MuscleEvent")
    if d then return d end
    local c = LP.Character
    if c then
        local e = c:FindFirstChild("MuscleEvent")
        if e then return e end
    end
    local re = RPS:FindFirstChild("rEvents")
    if re then
        return re:FindFirstChild("muscleEvent") or re:FindFirstChild("MuscleEvent")
    end
    return nil
end

local function GetRebirthRemote()
    local re = RPS:FindFirstChild("rEvents")
    return re and re:FindFirstChild("rebirthRemote")
end

local function FirePunch()
    local m = GetMuscleEvent()
    if m then
        pcall(function()
            m:FireServer("punch", "leftHand")
            m:FireServer("punch", "rightHand")
        end)
    end
end

local function EquipPunch()
    local c = LP.Character
    if not c then return end
    if not c:FindFirstChild("Punch") then
        local bp = LP:FindFirstChild("Backpack")
        if bp then
            local t = bp:FindFirstChild("Punch")
            if t then pcall(function() t.Parent = c end) end
        end
    end
end

local function GetHRP()
    local c = LP.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function GetHum()
    local c = LP.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end

