    local userLbl = SpecsSec:NewLabel("Username: N/A")
    local strLbl = SpecsSec:NewLabel("Strength: N/A")
    local rebLbl = SpecsSec:NewLabel("Rebirths: N/A")
    local durLbl = SpecsSec:NewLabel("Durability: N/A")

