local function GetMuscleEvent()
    local direct = LocalPlayer:FindFirstChild("MuscleEvent")
    if direct then return direct end
    local char = LocalPlayer.Character
    if char then
        local cEvent = char:FindFirstChild("MuscleEvent")
        if cEvent then return cEvent end
    end
    local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
    if rEvents then
        local rEvent = rEvents:FindFirstChild("muscleEvent") or rEvents:FindFirstChild("MuscleEvent")
        if rEvent then return rEvent end
    end
    return nil
end

local function GetRebirthRemote()
    local rEvents = ReplicatedStorage:FindFirstChild("rEvents")
    return rEvents and rEvents:FindFirstChild("rebirthRemote")
end

local function EquipPunchTool()
    local char = LocalPlayer.Character
    if not char then return end
    local tool = char:FindFirstChild("Punch")
    if not tool then
        local bp = LocalPlayer:FindFirstChild("Backpack")
        if bp then
            local bpTool = bp:FindFirstChild("Punch")
            if bpTool then bpTool.Parent = char end
        end
    end
end

local function FireMuscleEvent(...)
    local muscleEvent = GetMuscleEvent()
    if muscleEvent then
        pcall(function() muscleEvent:FireServer(...) end)
        return true
    end
    return false
end

local function FireRebirth()
    local rebirthRemote = GetRebirthRemote()
    if rebirthRemote then
        pcall(function() rebirthRemote:InvokeServer("rebirthRequest") end)
        return true
    end
    return false
end

local function GetChar() return LocalPlayer.Character end
local function GetHum() local c = GetChar() return c and c:FindFirstChildOfClass("Humanoid") end
local function GetHRP() local c = GetChar() return c and c:FindFirstChild("HumanoidRootPart") end

