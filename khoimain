    end

    TpMainSec:NewButton("Main Island", "Đảo chính", function() TpTo(CFrame.new(0, 8, 0)) end)
    TpMainSec:NewButton("Tiny Island", "Đảo nhỏ", function() TpTo(CFrame.new(-38, 8, 1860)) end)
    TpMainSec:NewButton("Beach", "Bãi biển", function() TpTo(CFrame.new(-2560, 8, -260)) end)

    local TpGymSec = TpTab:NewSection("Gyms")
    TpGymSec:NewButton("Frost Gym", "Đảo Băng", function() TpTo(CFrame.new(-2600, 8, -5000)) end)
    TpGymSec:NewButton("Mythical Gym", "", function() TpTo(CFrame.new(2250, 8, 1070)) end)
    TpGymSec:NewButton("Infernal Gym", "", function() TpTo(CFrame.new(-6700, 8, -1280)) end)
    TpGymSec:NewButton("Legends Gym", "", function() TpTo(CFrame.new(4600, 8, -3800)) end)
    TpGymSec:NewButton("Muscle King Gym", "", function() TpTo(CFrame.new(-8600, 8, -5700)) end)

    local StatsTab = Window:NewTab("Stats")
    local ElSec = StatsTab:NewSection("Elapsed Time")
    local timeLbl = ElSec:NewLabel("0d 0h 0m 0s")
    local startTime = tick()

    task.spawn(function()
        while task.wait(1) do
            local elapsed = tick() - startTime
            local d = math.floor(elapsed / 86400)
            local h = math.floor((elapsed % 86400) / 3600)
            local m = math.floor((elapsed % 3600) / 60)
            local s = math.floor(elapsed % 60)
            timeLbl.Text = string.format("%dd %dh %dm %ds", d, h, m, s)
        end
    end)

    task.spawn(function()
        while task.wait(0.12) do
            if States.AutoPunch then
                EquipPunchTool()
                FireMuscleEvent("punch", "leftHand")
                FireMuscleEvent("punch", "rightHand")
            end

            if States.KillList or States.KillAura then
                local myHrp = GetHRP()
                if myHrp then
                    for _, plr in pairs(Players:GetPlayers()) do
                        if plr ~= LocalPlayer and plr.Character then
                            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
                            local targetHrp = plr.Character:FindFirstChild("HumanoidRootPart")

                            if hum and hum.Health > 0 and targetHrp then
                                local dist = (myHrp.Position - targetHrp.Position).Magnitude
                                if (States.KillList and dist < 20) or (States.KillAura and dist < States.KillRange) then
                                    EquipPunchTool()
                                    FireMuscleEvent("punch", "leftHand")
                                    FireMuscleEvent("punch", "rightHand")
                                end
                            end
                        end
                    end
                end
            end
        end
    end)

    task.spawn(function()
        while task.wait(1) do
            if States.AutoRebirth then
                FireRebirth()
            end
            if States.AutoSize1 then
                local char = GetChar()
                if char then pcall(function() char:ScaleTo(0.1) end) end
            end
        end
    end)

    Window:Notify("KhoiFarm đã tối ưu & sửa lỗi hoàn tất!", 5)
end

