    local MainTab = Window:NewTab("Main")
    local MainSec = MainTab:NewSection("User Settings")

    MainSec:NewSlider("Size", "Kích thước nhân vật", 500, 1, function(v)
        local char = GetChar()
        if char then
            pcall(function() char:ScaleTo(v / 10) end)
        end
    end)

    MainSec:NewSlider("Speed", "Tốc độ chạy", 500, 16, function(v)
        local hum = GetHum()
        if hum then hum.WalkSpeed = v end
    end)

    MainSec:NewSlider("FOV", "Tầm nhìn Camera", 120, 70, function(v)
        workspace.CurrentCamera.FieldOfView = v
    end)

    local ProtSec = MainTab:NewSection("Protection and Visuals")
    local antiFlingConn
    ProtSec:NewToggle("Anti Fling", "Chống bị hất văng", function(s)
        if s then
            antiFlingConn = RunService.Heartbeat:Connect(function()
                local hrp = GetHRP()
                if hrp then
                    hrp.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0.01, 0.01, 0, 0)
                end
            end)
        else
            if antiFlingConn then antiFlingConn:Disconnect() end
            local hrp = GetHRP()
            if hrp then hrp.CustomPhysicalProperties = nil end
        end
    end)

    ProtSec:NewToggle("Lock Position", "Khóa vị trí nhân vật", function(s)
        local hrp = GetHRP()
        if hrp then hrp.Anchored = s end
    end)

    local walkWaterConn
    ProtSec:NewToggle("Walk on Water", "Đi trên nước", function(s)
        if s then
            walkWaterConn = RunService.Heartbeat:Connect(function()
                local hrp = GetHRP()
                if hrp and hrp.Position.Y < 1.5 then
                    hrp.Velocity = Vector3.new(hrp.Velocity.X, 30, hrp.Velocity.Z)
                end
            end)
        else
            if walkWaterConn then walkWaterConn:Disconnect() end
        end
    end)

    local OtherSec = MainTab:NewSection("Other")
    local infJump = false
    OtherSec:NewToggle("Infinite Jump", "Nhảy vô hạn", function(s) infJump = s end)
    UserInputService.JumpRequest:Connect(function()
        if infJump then
            local hum = GetHum()
            if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
        end
    end)

    local KillTab = Window:NewTab("Killing")
    local TargetSec = KillTab:NewSection("Target Killing")
